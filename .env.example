# OpenAI-compatible chat completions endpoint, e.g. https://api.example.com/v1
GUGU_API_BASE_URL=
GUGU_API_KEY=
GUGU_MODEL=

# Local runtime settings
GUGU_DATA_DIR=./data
GUGU_OWNER_NAME=主人
GUGU_HEARTBEAT_MIN=45
GUGU_TIMEZONE=Asia/Shanghai
GUGU_ACTIVE_HOUR_START=9
GUGU_ACTIVE_HOUR_END=23
GUGU_PROACTIVE_DAILY_LIMIT=3
GUGU_PROACTIVE_COOLDOWN_MIN=60
GUGU_DEFAULT_CHANNEL=qq
GUGU_CONTROL_ENABLED=true
GUGU_CONTROL_PORT=7862

# Set these after configuring the respective channel adapters.
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_OWNER_ID=
DOUYIN_BASE_URL=http://127.0.0.1:7861
DOUYIN_OWNER_NAME=
